<Window x:Class="Attractor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ghostcade" Height="1240" Width="1373" MinHeight="640" MinWidth="1373" MaxWidth="1373"
        Background="#FF050507" WindowStartupLocation="CenterScreen">

  <!-- Chrome is Steve's artwork (1341px-wide design). Two layout modes, chosen
       by window height in code-behind: FULL (>=1080 tall) is the fixed cabinet;
       SLIM (<1080) drops the right panel, relocates the countdown to a chip,
       and lets the banner/buttons scale down (Viewboxes + star rows). One
       shared HostRegion, so the embedded MAME window just re-glues on reflow. -->

  <DockPanel>
    <Menu DockPanel.Dock="Top" Background="Transparent" Foreground="{StaticResource TextDim}">
      <MenuItem Header="_File">
        <MenuItem Header="_Play this game" Command="{Binding PlayThisCommand}" InputGestureText="Ctrl+Alt+P"/>
        <Separator/>
        <MenuItem Header="_Rescan ROMs" Command="{Binding RescanCommand}"/>
        <MenuItem Header="Setup _Wizard…" Click="SetupWizardMenu_Click"/>
        <MenuItem Header="_Open config folder" Command="{Binding OpenConfigFolderCommand}"/>
        <Separator/>
        <MenuItem Header="E_xit" Click="ExitMenu_Click"/>
      </MenuItem>
      <MenuItem x:Name="FilterMenu" Header="F_ilter">
        <MenuItem Header="(loading…)" IsEnabled="False"/>
      </MenuItem>
      <MenuItem x:Name="TimeoutMenu" Header="_Time out">
        <MenuItem Header="_1 minute"   IsCheckable="True" Tag="60"  Click="TimeoutItem_Click"/>
        <MenuItem Header="_2 minutes"  IsCheckable="True" Tag="120" Click="TimeoutItem_Click"/>
        <MenuItem Header="_3 minutes"  IsCheckable="True" Tag="180" Click="TimeoutItem_Click"/>
        <MenuItem Header="_5 minutes"  IsCheckable="True" Tag="300" Click="TimeoutItem_Click"/>
        <MenuItem Header="1_0 minutes" IsCheckable="True" Tag="600" Click="TimeoutItem_Click"/>
        <MenuItem Header="1_5 minutes" IsCheckable="True" Tag="900" Click="TimeoutItem_Click"/>
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="_About Ghostcade" Click="AboutMenu_Click"/>
      </MenuItem>
    </Menu>

    <Grid x:Name="Root" Width="1341" HorizontalAlignment="Center">
      <Grid.RowDefinitions>
        <RowDefinition x:Name="BannerRow" Height="243"/>
        <RowDefinition x:Name="StageRow" Height="*"/>
        <RowDefinition x:Name="ButtonsRow" Height="162"/>
      </Grid.RowDefinitions>

      <!-- ============ marquee banner (+ slim chip), centred as one group ============ -->
      <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Stretch">
        <Viewbox Stretch="Uniform" VerticalAlignment="Center">
          <Grid Width="1341" Height="243">
            <Image Source="pack://application:,,,/assets/img/top_banner.jpg" Stretch="Fill"/>
            <Grid Margin="210,36,205,36">
              <!-- text marquee only when a game has no marquee art -->
              <TextBlock Text="{Binding Title}"
                         FontFamily="{StaticResource PixelFont}" FontSize="26"
                         Foreground="{StaticResource Amber}" LineHeight="38"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         TextAlignment="Center" TextWrapping="Wrap" Margin="20,0">
                <TextBlock.Effect>
                  <DropShadowEffect Color="{StaticResource AmberColor}" BlurRadius="18" ShadowDepth="0" Opacity="0.9"/>
                </TextBlock.Effect>
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding MarqueeImage}" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <Image Source="{Binding MarqueeImage}" Stretch="Uniform" Margin="6"
                     RenderOptions.BitmapScalingMode="HighQuality"/>
            </Grid>
          </Grid>
        </Viewbox>

        <!-- slim-mode countdown chip, directly to the right of the banner
             (collapsed in full mode; the info panel shows the countdown there) -->
        <Border x:Name="CountdownChip" Visibility="Collapsed"
                VerticalAlignment="Center" Margin="18,0,0,0"
                Background="#CC0B0B11" BorderBrush="{StaticResource NeonMagenta}" BorderThickness="2"
                CornerRadius="8" Padding="18,8">
          <Border.Effect>
            <DropShadowEffect Color="{StaticResource MagentaColor}" BlurRadius="14" ShadowDepth="0" Opacity="0.6"/>
          </Border.Effect>
          <StackPanel>
            <TextBlock Text="{Binding CountdownLabel}" FontFamily="{StaticResource PixelFont}" FontSize="11"
                       Foreground="{StaticResource NeonMagenta}" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding CountdownValue}" FontFamily="{StaticResource LedFont}" FontWeight="Bold"
                       FontSize="34" Foreground="{StaticResource Led}" HorizontalAlignment="Center" Margin="0,4,0,0">
              <TextBlock.Effect>
                <DropShadowEffect Color="{StaticResource LedColor}" BlurRadius="14" ShadowDepth="0" Opacity="0.9"/>
              </TextBlock.Effect>
            </TextBlock>
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- ============ stage row ============ -->
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition x:Name="GapColumn" Width="9"/>
          <ColumnDefinition x:Name="PanelColumn" Width="391"/>
        </Grid.ColumnDefinitions>

        <!-- CRT screen built from three art slices; middle tiles vertically.
             Fixed 941 wide and centred, so collapsing the panel just gives it
             more dark breathing room rather than stretching the bezel. -->
        <Grid Grid.Column="0" Width="941" HorizontalAlignment="Center">
          <Grid.RowDefinitions>
            <RowDefinition Height="256"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="277"/>
          </Grid.RowDefinitions>
          <Image Grid.Row="0" Source="pack://application:,,,/assets/img/top_screen.jpg" Stretch="Fill"/>
          <Rectangle Grid.Row="1">
            <Rectangle.Fill>
              <ImageBrush ImageSource="pack://application:,,,/assets/img/middle_screen.jpg"
                          TileMode="Tile" Stretch="None" AlignmentY="Top"
                          Viewport="0,0,941,235" ViewportUnits="Absolute"/>
            </Rectangle.Fill>
          </Rectangle>
          <Image Grid.Row="2" Source="pack://application:,,,/assets/img/bottom_screen.jpg" Stretch="Fill"/>

          <!-- the MAME window is glued over this region; snap art masks gaps -->
          <Grid x:Name="HostRegion" Grid.Row="0" Grid.RowSpan="3" Margin="120,36,50,48">
            <Image Source="{Binding MaskImage}" Stretch="Uniform" Opacity="0.85"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Text="{Binding StageMessage}" Foreground="#FF3FE3FF" FontFamily="{StaticResource PixelFont}"
                       FontSize="13" LineHeight="26" HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextWrapping="Wrap" TextAlignment="Center" Margin="60" Opacity="0.85"/>
          </Grid>
        </Grid>

        <!-- info panel art, top aligned, with the text stack overlaid -->
        <Grid x:Name="RightPanel" Grid.Column="2" VerticalAlignment="Top" Height="732">
          <Image Source="pack://application:,,,/assets/img/right_panel.jpg" Stretch="Fill"/>
          <StackPanel Margin="34,40,34,40">
            <TextBlock Text="{Binding Title}" Style="{StaticResource PixelTitle}"/>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
              <TextBlock Text="&#xE787;" FontFamily="{StaticResource Glyphs}" FontSize="15"
                         Foreground="{StaticResource Amber}" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding Year}" FontFamily="{StaticResource PixelFont}" FontSize="13"
                         Foreground="{StaticResource Amber}" Margin="8,0,0,0" VerticalAlignment="Center"/>
              <TextBlock Text="|" Foreground="{StaticResource TextDim}" Margin="10,0" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding Manufacturer}" FontSize="14" Foreground="#FFE8D27A"
                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
              <Border Style="{StaticResource BadgeBorder}" BorderBrush="{StaticResource GoodGreen}">
                <TextBlock Text="{Binding VerifyBadge}" Style="{StaticResource BadgeText}"
                           Foreground="{StaticResource GoodGreen}"/>
              </Border>
              <Border Style="{StaticResource BadgeBorder}" BorderBrush="{StaticResource NeonCyan}">
                <TextBlock Text="{Binding DriverBadge}" Style="{StaticResource BadgeText}"
                           Foreground="{StaticResource NeonCyan}"/>
              </Border>
            </StackPanel>

            <TextBlock Text="{Binding FavoriteIndicator}" FontFamily="{StaticResource PixelFont}"
                       FontSize="10" Foreground="{StaticResource Amber}" Margin="0,12,0,0"/>

            <Rectangle Height="2" Fill="{StaticResource NeonMagenta}" Opacity="0.65" Margin="0,14">
              <Rectangle.Effect>
                <DropShadowEffect Color="{StaticResource MagentaColor}" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/>
              </Rectangle.Effect>
            </Rectangle>

            <TextBlock Text="{Binding CountdownLabel}" FontFamily="{StaticResource PixelFont}" FontSize="12"
                       Foreground="{StaticResource NeonMagenta}" HorizontalAlignment="Center"/>
            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Rectangle Grid.Column="0" Height="2" Fill="{StaticResource NeonMagenta}" Opacity="0.5" Margin="4,0,12,0" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="{Binding CountdownValue}" FontFamily="{StaticResource LedFont}"
                         FontWeight="Bold" FontSize="42" Foreground="{StaticResource Led}">
                <TextBlock.Effect>
                  <DropShadowEffect Color="{StaticResource LedColor}" BlurRadius="16" ShadowDepth="0" Opacity="0.9"/>
                </TextBlock.Effect>
              </TextBlock>
              <Rectangle Grid.Column="2" Height="2" Fill="{StaticResource NeonMagenta}" Opacity="0.5" Margin="12,0,4,0" VerticalAlignment="Center"/>
            </Grid>
            <TextBlock Text="{Binding QueueText}" FontSize="12" Foreground="{StaticResource NeonCyan}"
                       HorizontalAlignment="Center" Margin="0,10,0,0" Opacity="0.85"/>

            <!-- take the controls: kills the attract chunk and launches a real,
                 focused, uncapped MAME session; rotation resumes when it exits -->
            <Button Command="{Binding PlayThisCommand}" HorizontalAlignment="Center" Margin="0,12,0,0"
                    Cursor="Hand" Focusable="False"
                    ToolTip="Play this game for real (Ctrl+Alt+P) — quit MAME to resume the rotation">
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <Border x:Name="Frame" Background="#CC10101B" BorderBrush="{StaticResource Amber}"
                          BorderThickness="2" CornerRadius="8" Padding="18,8">
                    <Border.Effect>
                      <DropShadowEffect Color="{StaticResource AmberColor}" BlurRadius="12" ShadowDepth="0" Opacity="0.55"/>
                    </Border.Effect>
                    <TextBlock x:Name="Label" FontFamily="{StaticResource PixelFont}" FontSize="12"
                               Foreground="{StaticResource Amber}"
                               Text="{Binding PlayButtonLabel}"/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Frame" Property="Background" Value="#FF241A08"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                      <Setter TargetName="Frame" Property="Background" Value="#FF382A0C"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                      <Setter TargetName="Frame" Property="Opacity" Value="0.55"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Button.Template>
            </Button>

            <Rectangle Height="2" Fill="{StaticResource NeonMagenta}" Opacity="0.65" Margin="0,14">
              <Rectangle.Effect>
                <DropShadowEffect Color="{StaticResource MagentaColor}" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/>
              </Rectangle.Effect>
            </Rectangle>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{Binding AboutHeader}" VerticalAlignment="Center"
                         FontFamily="{StaticResource PixelFont}" FontSize="11"
                         Foreground="{StaticResource Amber}"/>
              <!-- manual section-advance; only shown when the game has more than one history section -->
              <Button Grid.Column="1" Command="{Binding NextAboutSectionCommand}"
                      Visibility="{Binding HasMultipleAboutSections, Converter={StaticResource BoolToVis}}"
                      Cursor="Hand" Focusable="False" VerticalAlignment="Center" ToolTip="Next section">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border x:Name="Frame" Background="#CC10101B" BorderBrush="{StaticResource Amber}"
                            BorderThickness="1.5" CornerRadius="6" Padding="8,2">
                      <Border.Effect>
                        <DropShadowEffect Color="{StaticResource AmberColor}" BlurRadius="8" ShadowDepth="0" Opacity="0.5"/>
                      </Border.Effect>
                      <!-- Segoe MDL2 ChevronRight (PUA glyph) -->
                      <TextBlock FontFamily="{StaticResource Glyphs}" FontSize="12"
                                 Foreground="{StaticResource Amber}" Text="&#xE76C;"/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Frame" Property="Background" Value="#FF241A08"/>
                      </Trigger>
                      <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="Frame" Property="Background" Value="#FF382A0C"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Button.Template>
              </Button>
            </Grid>
            <TextBlock Text="{Binding AboutText}" Style="{StaticResource DimText}" Margin="0,8,0,0"
                       MaxHeight="150" TextTrimming="WordEllipsis" LineHeight="19" FontSize="12"/>

            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource DimText}" FontSize="11"
                       Foreground="#FFCF8A3B" Margin="0,10,0,0"/>
          </StackPanel>
        </Grid>
      </Grid>

      <!-- ============ transport (art + invisible hit areas, scales as one) ============ -->
      <Grid Grid.Row="2">
        <Viewbox Stretch="Uniform">
          <Grid Width="1341" Height="162">
            <Image Source="pack://application:,,,/assets/img/bottom_buttons.jpg" Stretch="Fill"/>
            <Canvas>
              <Button Style="{StaticResource ArtButton}" Command="{Binding PreviousCommand}"
                      Canvas.Left="71" Canvas.Top="2" Width="144" Height="156" ToolTip="Previous (Ctrl+Alt+Left)"/>
              <Button Style="{StaticResource ArtButton}" Command="{Binding HoldCommand}"
                      Canvas.Left="279" Canvas.Top="2" Width="144" Height="156" ToolTip="Hold (Ctrl+Alt+Down)"/>
              <Button Style="{StaticResource ArtButton}" Command="{Binding SkipCommand}"
                      Canvas.Left="495" Canvas.Top="2" Width="144" Height="156" ToolTip="Skip (Ctrl+Alt+Right)"/>
              <Button Style="{StaticResource ArtButton}" Command="{Binding BanCommand}"
                      Canvas.Left="703" Canvas.Top="2" Width="144" Height="156" ToolTip="Ban (Ctrl+Alt+B)"/>
              <Button Style="{StaticResource ArtButton}" Command="{Binding FavoriteCommand}"
                      Canvas.Left="911" Canvas.Top="2" Width="144" Height="156" ToolTip="Favourite (Ctrl+Alt+F)"/>
              <Button Style="{StaticResource ArtButton}" Command="{Binding MuteCommand}"
                      Canvas.Left="1119" Canvas.Top="2" Width="144" Height="156" ToolTip="Mute (Ctrl+Alt+M)"/>

              <!-- state overlays on the painted buttons -->
              <Ellipse Canvas.Left="297" Canvas.Top="4" Width="108" Height="104" Stroke="{StaticResource NeonMagenta}"
                       StrokeThickness="3" IsHitTestVisible="False"
                       Visibility="{Binding IsHeld, Converter={StaticResource BoolToVis}}">
                <Ellipse.Effect>
                  <DropShadowEffect Color="{StaticResource MagentaColor}" BlurRadius="14" ShadowDepth="0" Opacity="0.9"/>
                </Ellipse.Effect>
              </Ellipse>
              <TextBlock Canvas.Left="1163" Canvas.Top="30" Text="&#xE74F;" FontFamily="{StaticResource Glyphs}"
                         FontSize="42" Foreground="#FFFF5048" IsHitTestVisible="False"
                         Visibility="{Binding IsMuted, Converter={StaticResource BoolToVis}}">
                <TextBlock.Effect>
                  <DropShadowEffect Color="#FF000000" BlurRadius="8" ShadowDepth="0" Opacity="0.9"/>
                </TextBlock.Effect>
              </TextBlock>
            </Canvas>
          </Grid>
        </Viewbox>
      </Grid>

      <!-- Floating MAME-volume control, hovering just above the SOUND ON (mute)
           button over the dead space beside the screen. Full layout only — the
           code-behind hides it in slim mode (the screen widens into this spot);
           Ctrl+Alt + / - and the status line cover slim. -->
      <Border x:Name="VolumeOverlay" Grid.Row="1" Panel.ZIndex="50"
              HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,42,10"
              Width="218" Padding="14,8,14,10"
              Background="#E60C0C13" BorderBrush="{StaticResource NeonCyan}" BorderThickness="1.5"
              CornerRadius="10">
        <Border.Effect>
          <DropShadowEffect Color="{StaticResource CyanColor}" BlurRadius="16" ShadowDepth="0" Opacity="0.45"/>
        </Border.Effect>
        <StackPanel>
          <TextBlock Text="{Binding VolumeReadout}" FontFamily="{StaticResource PixelFont}" FontSize="9"
                     Foreground="{StaticResource NeonCyan}" HorizontalAlignment="Center"/>
          <Slider Style="{StaticResource NeonSlider}" Value="{Binding GameVolume, Mode=TwoWay}"
                  Margin="0,9,0,0" ToolTip="MAME volume — independent of Windows system volume (Ctrl+Alt + / -)"/>
        </StackPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
