<Window x:Class="Attractor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Attractor" Height="900" Width="1400"
        Background="#FF0C0C10" WindowStartupLocation="CenterScreen">

  <Window.Resources>
    <SolidColorBrush x:Key="PanelBg" Color="#FF15151C"/>
    <SolidColorBrush x:Key="PanelEdge" Color="#FF26262F"/>
    <SolidColorBrush x:Key="TextDim" Color="#FF8A8A99"/>
    <SolidColorBrush x:Key="TextMain" Color="Gainsboro"/>

    <Style TargetType="Button" x:Key="Transport">
      <Setter Property="Margin" Value="6,0"/>
      <Setter Property="Padding" Value="16,8"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Background" Value="#FF1E1E28"/>
      <Setter Property="Foreground" Value="Gainsboro"/>
      <Setter Property="BorderBrush" Value="#FF34343F"/>
    </Style>
    <Style TargetType="Border" x:Key="Badge">
      <Setter Property="Background" Value="#FF1E1E28"/>
      <Setter Property="BorderBrush" Value="#FF34343F"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="3"/>
      <Setter Property="Padding" Value="7,3"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="150"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="64"/>
    </Grid.RowDefinitions>

    <!-- marquee banner -->
    <Border Grid.Row="0" Background="{StaticResource PanelBg}"
            BorderBrush="{StaticResource PanelEdge}" BorderThickness="0,0,0,1">
      <Grid>
        <TextBlock Text="{Binding Title}" FontSize="40" FontWeight="Bold"
                   Foreground="#FFE8C66B" HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" Margin="24,0"/>
        <Image Source="{Binding MarqueeImage}" Stretch="Uniform" Margin="10"
               RenderOptions.BitmapScalingMode="HighQuality"/>
      </Grid>
    </Border>

    <!-- stage -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="300"/>
      </Grid.ColumnDefinitions>

      <!-- the MAME window is glued over this region; the snap image behind it
           is what shows during the brief chunk-relaunch gaps -->
      <Border Grid.Column="0" x:Name="HostRegion" Background="#FF050507" Margin="14,14,0,14">
        <Grid>
          <Image Source="{Binding MaskImage}" Stretch="Uniform" Opacity="0.85"
                 RenderOptions.BitmapScalingMode="HighQuality"/>
          <TextBlock Text="{Binding StageMessage}" Foreground="#FF5A5A68" FontSize="17"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     TextWrapping="Wrap" TextAlignment="Center" Margin="48"/>
        </Grid>
      </Border>

      <!-- info panel -->
      <StackPanel Grid.Column="1" Margin="14">
        <TextBlock Text="{Binding Title}" FontSize="21" FontWeight="SemiBold"
                   Foreground="{StaticResource TextMain}" TextWrapping="Wrap"/>
        <TextBlock FontSize="14" Foreground="{StaticResource TextDim}" Margin="0,8,0,0">
          <Run Text="{Binding Year}"/><Run Text="  ·  "/><Run Text="{Binding Manufacturer}"/>
        </TextBlock>

        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
          <Border Style="{StaticResource Badge}">
            <TextBlock Text="{Binding VerifyBadge}" Foreground="{StaticResource TextDim}" FontSize="12"/>
          </Border>
          <Border Style="{StaticResource Badge}">
            <TextBlock Text="{Binding DriverBadge}" Foreground="{StaticResource TextDim}" FontSize="12"/>
          </Border>
        </StackPanel>

        <TextBlock Text="{Binding FavoriteIndicator}" FontSize="14" Foreground="#FFE8C66B" Margin="0,12,0,0"/>

        <Rectangle Height="1" Fill="{StaticResource PanelEdge}" Margin="0,16"/>

        <TextBlock Text="{Binding CountdownText}" FontSize="17" Foreground="{StaticResource TextMain}"/>
        <TextBlock Text="{Binding QueueText}" FontSize="12" Foreground="{StaticResource TextDim}" Margin="0,6,0,0"/>

        <Rectangle Height="1" Fill="{StaticResource PanelEdge}" Margin="0,16"/>

        <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{StaticResource TextDim}"
                   TextWrapping="Wrap"/>
      </StackPanel>
    </Grid>

    <!-- transport -->
    <Border Grid.Row="2" Background="{StaticResource PanelBg}"
            BorderBrush="{StaticResource PanelEdge}" BorderThickness="0,1,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Button Style="{StaticResource Transport}" Content="⏮  Prev" Command="{Binding PreviousCommand}"/>
        <Button Style="{StaticResource Transport}" Content="{Binding HoldLabel}" Command="{Binding HoldCommand}"/>
        <Button Style="{StaticResource Transport}" Content="⏭  Skip" Command="{Binding SkipCommand}"/>
        <Button Style="{StaticResource Transport}" Content="🚫  Ban" Command="{Binding BanCommand}"/>
        <Button Style="{StaticResource Transport}" Content="{Binding FavoriteLabel}" Command="{Binding FavoriteCommand}"/>
        <Button Style="{StaticResource Transport}" Content="{Binding MuteLabel}" Command="{Binding MuteCommand}"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
