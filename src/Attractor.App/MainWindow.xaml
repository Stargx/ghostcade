<Window x:Class="Attractor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Attractor" Height="980" Width="1500" MinHeight="760" MinWidth="1150"
        Background="{StaticResource BgDeep}" WindowStartupLocation="CenterScreen">

  <Grid Margin="14,4,14,10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="172"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="128"/>
    </Grid.RowDefinitions>

    <Menu Grid.Row="0" Background="Transparent" Foreground="{StaticResource TextDim}" Margin="0,0,0,4">
      <MenuItem Header="_File">
        <MenuItem Header="_Rescan ROMs" Command="{Binding RescanCommand}"/>
        <MenuItem Header="_Open config folder" Command="{Binding OpenConfigFolderCommand}"/>
        <Separator/>
        <MenuItem Header="E_xit" Click="ExitMenu_Click"/>
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="_About Attractor" Click="AboutMenu_Click"/>
      </MenuItem>
    </Menu>

    <!-- ================= marquee row ================= -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="120"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="120"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{StaticResource MetalPanel}" Margin="0,10,12,10">
        <Border Margin="12" CornerRadius="8" Background="{StaticResource VentBrush}"
                BorderBrush="#FF2B2B38" BorderThickness="1.5"/>
      </Border>

      <Border Grid.Column="1" Style="{StaticResource MarqueeFrame}">
        <Grid ClipToBounds="True">
          <TextBlock Text="{Binding Title}" Style="{StaticResource PixelTitle}"
                     FontSize="26" Foreground="{StaticResource Amber}"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     TextAlignment="Center" Margin="30,0">
            <TextBlock.Effect>
              <DropShadowEffect Color="{StaticResource AmberColor}" BlurRadius="18" ShadowDepth="0" Opacity="0.9"/>
            </TextBlock.Effect>
          </TextBlock>
          <Image Source="{Binding MarqueeImage}" Stretch="Uniform" Margin="12,8"
                 RenderOptions.BitmapScalingMode="HighQuality"/>
        </Grid>
      </Border>

      <Border Grid.Column="2" Style="{StaticResource MetalPanel}" Margin="12,10,0,10">
        <Border Margin="12" CornerRadius="8" Background="{StaticResource VentBrush}"
                BorderBrush="#FF2B2B38" BorderThickness="1.5"/>
      </Border>
    </Grid>

    <!-- ================= stage row ================= -->
    <Grid Grid.Row="2" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="330"/>
      </Grid.ColumnDefinitions>

      <!-- CRT screen: neon bezel, dark glass; the MAME window is glued over
           the inner HostRegion; the snap image behind it masks chunk gaps -->
      <Border Grid.Column="0" Style="{StaticResource NeonFrame}" CornerRadius="24">
        <Border Margin="9" CornerRadius="18" Background="#FF050508"
                BorderBrush="#FF101820" BorderThickness="4">
          <Grid x:Name="HostRegion" Margin="10">
            <Image Source="{Binding MaskImage}" Stretch="Uniform" Opacity="0.8"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Text="{Binding StageMessage}" Foreground="#FF3FE3FF" FontFamily="{StaticResource PixelFont}"
                       FontSize="13" LineHeight="26" HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextWrapping="Wrap" TextAlignment="Center" Margin="60" Opacity="0.8"/>
          </Grid>
        </Border>
      </Border>

      <!-- info panel -->
      <Border Grid.Column="1" Style="{StaticResource MetalPanel}" Margin="14,0,0,0">
        <Grid>
          <Ellipse Style="{StaticResource Screw}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
          <Ellipse Style="{StaticResource Screw}" HorizontalAlignment="Right" VerticalAlignment="Top"/>
          <Ellipse Style="{StaticResource Screw}" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
          <Ellipse Style="{StaticResource Screw}" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>

          <StackPanel Margin="22,24">
            <TextBlock Text="{Binding Title}" Style="{StaticResource PixelTitle}"/>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
              <TextBlock Text="&#xE787;" FontFamily="{StaticResource Glyphs}" FontSize="15"
                         Foreground="{StaticResource Amber}" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding Year}" FontFamily="{StaticResource PixelFont}" FontSize="13"
                         Foreground="{StaticResource Amber}" Margin="8,0,0,0" VerticalAlignment="Center"/>
              <TextBlock Text="|" Foreground="{StaticResource TextDim}" Margin="10,0" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding Manufacturer}" FontSize="14" Foreground="#FFE8D27A"
                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
              <Border Style="{StaticResource BadgeBorder}" BorderBrush="{StaticResource GoodGreen}">
                <TextBlock Text="{Binding VerifyBadge}" Style="{StaticResource BadgeText}"
                           Foreground="{StaticResource GoodGreen}"/>
              </Border>
              <Border Style="{StaticResource BadgeBorder}" BorderBrush="{StaticResource NeonCyan}">
                <TextBlock Text="{Binding DriverBadge}" Style="{StaticResource BadgeText}"
                           Foreground="{StaticResource NeonCyan}"/>
              </Border>
            </StackPanel>

            <TextBlock Text="{Binding FavoriteIndicator}" FontFamily="{StaticResource PixelFont}"
                       FontSize="10" Foreground="{StaticResource Amber}" Margin="0,12,0,0"/>

            <Rectangle Height="2" Fill="{StaticResource NeonMagenta}" Opacity="0.65" Margin="0,16">
              <Rectangle.Effect>
                <DropShadowEffect Color="{StaticResource MagentaColor}" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/>
              </Rectangle.Effect>
            </Rectangle>

            <TextBlock Text="{Binding CountdownLabel}" FontFamily="{StaticResource PixelFont}" FontSize="12"
                       Foreground="{StaticResource NeonMagenta}" HorizontalAlignment="Center"/>
            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Rectangle Grid.Column="0" Height="2" Fill="{StaticResource NeonMagenta}" Opacity="0.5" Margin="4,0,12,0" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="{Binding CountdownValue}" FontFamily="{StaticResource LedFont}"
                         FontWeight="Bold" FontSize="42" Foreground="{StaticResource Led}">
                <TextBlock.Effect>
                  <DropShadowEffect Color="{StaticResource LedColor}" BlurRadius="16" ShadowDepth="0" Opacity="0.9"/>
                </TextBlock.Effect>
              </TextBlock>
              <Rectangle Grid.Column="2" Height="2" Fill="{StaticResource NeonMagenta}" Opacity="0.5" Margin="12,0,4,0" VerticalAlignment="Center"/>
            </Grid>
            <TextBlock Text="{Binding QueueText}" FontSize="12" Foreground="{StaticResource NeonCyan}"
                       HorizontalAlignment="Center" Margin="0,10,0,0" Opacity="0.85"/>

            <Rectangle Height="2" Fill="{StaticResource NeonMagenta}" Opacity="0.65" Margin="0,16">
              <Rectangle.Effect>
                <DropShadowEffect Color="{StaticResource MagentaColor}" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/>
              </Rectangle.Effect>
            </Rectangle>

            <TextBlock Text="ABOUT" FontFamily="{StaticResource PixelFont}" FontSize="11"
                       Foreground="{StaticResource Amber}"/>
            <TextBlock Text="{Binding AboutText}" Style="{StaticResource DimText}" Margin="0,8,0,0"
                       MaxHeight="170" TextTrimming="WordEllipsis" LineHeight="19"/>

            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource DimText}" FontSize="11"
                       Foreground="#FFCF8A3B" Margin="0,12,0,0"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- ================= transport row ================= -->
    <Grid Grid.Row="3" Margin="0,10,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">

        <StackPanel Margin="14,0">
          <Border CornerRadius="42" Background="Transparent">
            <Border.Effect>
              <DropShadowEffect Color="#FF19A0FF" BlurRadius="24" ShadowDepth="0" Opacity="0.55"/>
            </Border.Effect>
            <Button Style="{StaticResource ArcadeButton}" Command="{Binding PreviousCommand}"
                    Content="&#xE892;" BorderBrush="#FF19A0FF">
              <Button.Background>
                <RadialGradientBrush GradientOrigin="0.5,0.35">
                  <GradientStop Color="#FF55C2FF" Offset="0"/>
                  <GradientStop Color="#FF0B5E9E" Offset="1"/>
                </RadialGradientBrush>
              </Button.Background>
            </Button>
          </Border>
          <Border Style="{StaticResource ButtonPlate}">
            <TextBlock Text="PREV" Style="{StaticResource PlateText}" Foreground="#FF6FD2FF"/>
          </Border>
        </StackPanel>

        <StackPanel Margin="14,0">
          <Border CornerRadius="42" Background="Transparent">
            <Border.Effect>
              <DropShadowEffect Color="{StaticResource MagentaColor}" BlurRadius="24" ShadowDepth="0" Opacity="0.55"/>
            </Border.Effect>
            <Button Style="{StaticResource ArcadeButton}" Command="{Binding HoldCommand}"
                    Content="{Binding HoldGlyph}" BorderBrush="{StaticResource NeonMagenta}">
              <Button.Background>
                <RadialGradientBrush GradientOrigin="0.5,0.35">
                  <GradientStop Color="#FFFF7BD0" Offset="0"/>
                  <GradientStop Color="#FF9E1167" Offset="1"/>
                </RadialGradientBrush>
              </Button.Background>
            </Button>
          </Border>
          <Border Style="{StaticResource ButtonPlate}">
            <TextBlock Text="{Binding HoldLabel}" Style="{StaticResource PlateText}" Foreground="#FFFF8AD6"/>
          </Border>
        </StackPanel>

        <StackPanel Margin="14,0">
          <Border CornerRadius="42" Background="Transparent">
            <Border.Effect>
              <DropShadowEffect Color="#FF37D837" BlurRadius="24" ShadowDepth="0" Opacity="0.55"/>
            </Border.Effect>
            <Button Style="{StaticResource ArcadeButton}" Command="{Binding SkipCommand}"
                    Content="&#xE893;" BorderBrush="#FF37D837">
              <Button.Background>
                <RadialGradientBrush GradientOrigin="0.5,0.35">
                  <GradientStop Color="#FF7FF07F" Offset="0"/>
                  <GradientStop Color="#FF18821E" Offset="1"/>
                </RadialGradientBrush>
              </Button.Background>
            </Button>
          </Border>
          <Border Style="{StaticResource ButtonPlate}">
            <TextBlock Text="SKIP" Style="{StaticResource PlateText}" Foreground="#FF86F086"/>
          </Border>
        </StackPanel>

        <StackPanel Margin="14,0">
          <Border CornerRadius="42" Background="Transparent">
            <Border.Effect>
              <DropShadowEffect Color="#FFFF3B30" BlurRadius="24" ShadowDepth="0" Opacity="0.55"/>
            </Border.Effect>
            <Button Style="{StaticResource ArcadeButton}" Command="{Binding BanCommand}"
                    Content="&#xE711;" BorderBrush="#FFFF3B30">
              <Button.Background>
                <RadialGradientBrush GradientOrigin="0.5,0.35">
                  <GradientStop Color="#FFFF8078" Offset="0"/>
                  <GradientStop Color="#FF9C1610" Offset="1"/>
                </RadialGradientBrush>
              </Button.Background>
            </Button>
          </Border>
          <Border Style="{StaticResource ButtonPlate}">
            <TextBlock Text="BAN" Style="{StaticResource PlateText}" Foreground="#FFFF847B"/>
          </Border>
        </StackPanel>

        <StackPanel Margin="14,0">
          <Border CornerRadius="42" Background="Transparent">
            <Border.Effect>
              <DropShadowEffect Color="{StaticResource AmberColor}" BlurRadius="24" ShadowDepth="0" Opacity="0.55"/>
            </Border.Effect>
            <Button Style="{StaticResource ArcadeButton}" Command="{Binding FavoriteCommand}"
                    Content="{Binding FavoriteGlyph}" BorderBrush="{StaticResource Amber}">
              <Button.Background>
                <RadialGradientBrush GradientOrigin="0.5,0.35">
                  <GradientStop Color="#FFFFD27A" Offset="0"/>
                  <GradientStop Color="#FFA66400" Offset="1"/>
                </RadialGradientBrush>
              </Button.Background>
            </Button>
          </Border>
          <Border Style="{StaticResource ButtonPlate}">
            <TextBlock Text="FAVOURITE" Style="{StaticResource PlateText}" Foreground="#FFFFC861"/>
          </Border>
        </StackPanel>

        <StackPanel Margin="14,0">
          <Border CornerRadius="42" Background="Transparent">
            <Border.Effect>
              <DropShadowEffect Color="#FF1FA9FF" BlurRadius="24" ShadowDepth="0" Opacity="0.55"/>
            </Border.Effect>
            <Button Style="{StaticResource ArcadeButton}" Command="{Binding MuteCommand}"
                    Content="{Binding MuteGlyph}" BorderBrush="#FF1FA9FF">
              <Button.Background>
                <RadialGradientBrush GradientOrigin="0.5,0.35">
                  <GradientStop Color="#FF6CC8FF" Offset="0"/>
                  <GradientStop Color="#FF0E5C96" Offset="1"/>
                </RadialGradientBrush>
              </Button.Background>
            </Button>
          </Border>
          <Border Style="{StaticResource ButtonPlate}">
            <TextBlock Text="{Binding MuteLabel}" Style="{StaticResource PlateText}" Foreground="#FF7BCFFF"/>
          </Border>
        </StackPanel>

      </StackPanel>
    </Grid>
  </Grid>
</Window>
