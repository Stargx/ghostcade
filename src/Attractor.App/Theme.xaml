<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ============ palette ============ -->
  <Color x:Key="CyanColor">#FF00E0FF</Color>
  <Color x:Key="MagentaColor">#FFFF2FB4</Color>
  <Color x:Key="AmberColor">#FFFFA01E</Color>
  <Color x:Key="LedColor">#FFFF9500</Color>

  <SolidColorBrush x:Key="BgDeep" Color="#FF08080C"/>
  <SolidColorBrush x:Key="PanelDark" Color="#FF0E0E15"/>
  <SolidColorBrush x:Key="MetalDark" Color="#FF14141C"/>
  <SolidColorBrush x:Key="PanelEdge" Color="#FF23232E"/>
  <SolidColorBrush x:Key="NeonCyan" Color="{StaticResource CyanColor}"/>
  <SolidColorBrush x:Key="NeonMagenta" Color="{StaticResource MagentaColor}"/>
  <SolidColorBrush x:Key="Amber" Color="{StaticResource AmberColor}"/>
  <SolidColorBrush x:Key="Led" Color="{StaticResource LedColor}"/>
  <SolidColorBrush x:Key="GoodGreen" Color="#FF58E05A"/>
  <SolidColorBrush x:Key="TextDim" Color="#FF9094AC"/>

  <FontFamily x:Key="PixelFont">pack://application:,,,/assets/fonts/#Press Start 2P</FontFamily>
  <FontFamily x:Key="LedFont">pack://application:,,,/assets/fonts/#DSEG7 Classic</FontFamily>
  <FontFamily x:Key="Glyphs">Segoe MDL2 Assets</FontFamily>

  <LinearGradientBrush x:Key="NeonEdge" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="{StaticResource CyanColor}" Offset="0"/>
    <GradientStop Color="#FF7B4DFF" Offset="0.55"/>
    <GradientStop Color="{StaticResource MagentaColor}" Offset="1"/>
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="MarqueeEdge" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="{StaticResource MagentaColor}" Offset="0"/>
    <GradientStop Color="#FFFF6FD8" Offset="0.5"/>
    <GradientStop Color="{StaticResource CyanColor}" Offset="1"/>
  </LinearGradientBrush>

  <!-- vent grille texture for the marquee side blocks -->
  <DrawingBrush x:Key="VentBrush" TileMode="Tile" Viewport="0,0,10,13" ViewportUnits="Absolute" Stretch="None">
    <DrawingBrush.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="#FF0A0A10">
          <GeometryDrawing.Geometry>
            <RectangleGeometry Rect="0,0,10,13"/>
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Brush="#FF1C1C26">
          <GeometryDrawing.Geometry>
            <RectangleGeometry Rect="0,3,10,7" RadiusX="2.5" RadiusY="2.5"/>
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingBrush.Drawing>
  </DrawingBrush>

  <!-- ============ text styles ============ -->
  <Style x:Key="PixelLabel" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource PixelFont}"/>
    <Setter Property="Foreground" Value="{StaticResource NeonCyan}"/>
    <Setter Property="FontSize" Value="12"/>
  </Style>

  <Style x:Key="PixelTitle" TargetType="TextBlock" BasedOn="{StaticResource PixelLabel}">
    <Setter Property="FontSize" Value="20"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="LineHeight" Value="30"/>
    <Setter Property="Effect">
      <Setter.Value>
        <DropShadowEffect Color="{StaticResource CyanColor}" BlurRadius="14" ShadowDepth="0" Opacity="0.85"/>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="DimText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <!-- ============ badges ============ -->
  <Style x:Key="BadgeBorder" TargetType="Border">
    <Setter Property="Background" Value="#FF0B0B11"/>
    <Setter Property="BorderThickness" Value="1.5"/>
    <Setter Property="CornerRadius" Value="5"/>
    <Setter Property="Padding" Value="9,5"/>
    <Setter Property="Margin" Value="0,0,8,0"/>
  </Style>

  <Style x:Key="BadgeText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource PixelFont}"/>
    <Setter Property="FontSize" Value="9"/>
  </Style>

  <!-- ============ neon frames ============ -->
  <Style x:Key="NeonFrame" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource PanelDark}"/>
    <Setter Property="BorderBrush" Value="{StaticResource NeonEdge}"/>
    <Setter Property="BorderThickness" Value="2.5"/>
    <Setter Property="CornerRadius" Value="18"/>
    <Setter Property="Effect">
      <Setter.Value>
        <DropShadowEffect Color="{StaticResource CyanColor}" BlurRadius="22" ShadowDepth="0" Opacity="0.35"/>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="MarqueeFrame" TargetType="Border" BasedOn="{StaticResource NeonFrame}">
    <Setter Property="BorderBrush" Value="{StaticResource MarqueeEdge}"/>
    <Setter Property="CornerRadius" Value="14"/>
    <Setter Property="Effect">
      <Setter.Value>
        <DropShadowEffect Color="{StaticResource MagentaColor}" BlurRadius="26" ShadowDepth="0" Opacity="0.45"/>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="MetalPanel" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource MetalDark}"/>
    <Setter Property="BorderBrush" Value="{StaticResource PanelEdge}"/>
    <Setter Property="BorderThickness" Value="1.5"/>
    <Setter Property="CornerRadius" Value="12"/>
  </Style>

  <Style x:Key="Screw" TargetType="Ellipse">
    <Setter Property="Width" Value="9"/>
    <Setter Property="Height" Value="9"/>
    <Setter Property="Margin" Value="9"/>
    <Setter Property="Fill">
      <Setter.Value>
        <RadialGradientBrush GradientOrigin="0.3,0.3">
          <GradientStop Color="#FF6A6F82" Offset="0"/>
          <GradientStop Color="#FF23252E" Offset="1"/>
        </RadialGradientBrush>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============ arcade buttons ============ -->
  <Style x:Key="ArcadeButton" TargetType="Button">
    <Setter Property="Width" Value="78"/>
    <Setter Property="Height" Value="78"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="FontFamily" Value="{StaticResource Glyphs}"/>
    <Setter Property="FontSize" Value="24"/>
    <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
    <Setter Property="RenderTransform">
      <Setter.Value>
        <ScaleTransform ScaleX="1" ScaleY="1"/>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Ellipse Fill="#FF0C0C12" Stroke="#FF2B2B38" StrokeThickness="2"/>
            <Ellipse x:Name="Ring" Margin="4" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="2.5" Opacity="0.95"/>
            <Ellipse x:Name="Dome" Margin="10" Fill="{TemplateBinding Background}"/>
            <Ellipse Margin="17,13,17,44" Opacity="0.5" IsHitTestVisible="False">
              <Ellipse.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                  <GradientStop Color="#D8FFFFFF" Offset="0"/>
                  <GradientStop Color="#00FFFFFF" Offset="1"/>
                </LinearGradientBrush>
              </Ellipse.Fill>
            </Ellipse>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
              <ContentPresenter.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="1" Opacity="0.7"/>
              </ContentPresenter.Effect>
            </ContentPresenter>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Ring" Property="StrokeThickness" Value="3.5"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter Property="RenderTransform">
                <Setter.Value>
                  <ScaleTransform ScaleX="0.93" ScaleY="0.93"/>
                </Setter.Value>
              </Setter>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ButtonPlate" TargetType="Border">
    <Setter Property="Background" Value="#FF101018"/>
    <Setter Property="BorderBrush" Value="{StaticResource PanelEdge}"/>
    <Setter Property="BorderThickness" Value="1.5"/>
    <Setter Property="CornerRadius" Value="5"/>
    <Setter Property="Padding" Value="10,4"/>
    <Setter Property="Margin" Value="0,8,0,0"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
  </Style>

  <Style x:Key="PlateText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource PixelFont}"/>
    <Setter Property="FontSize" Value="9"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
  </Style>

</ResourceDictionary>
