<Window x:Class="Attractor.App.ManufacturerFilterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Filter — manufacturers" Height="600" Width="460" MinHeight="360" MinWidth="360"
        Background="{StaticResource BgDeep}" WindowStartupLocation="CenterOwner">

  <Border Style="{StaticResource NeonFrame}" Margin="14" Padding="18">
    <DockPanel>
      <TextBlock DockPanel.Dock="Top" Text="MANUFACTURERS" Style="{StaticResource PixelLabel}" FontSize="14"/>
      <TextBlock DockPanel.Dock="Top" Style="{StaticResource DimText}" Margin="0,8,0,10" FontSize="12"
                 Text="Tick any to include. Nothing ticked = all manufacturers."/>

      <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Margin="0,0,0,10" Padding="8,7"
               Background="#FF0B0B11" Foreground="Gainsboro" BorderBrush="{StaticResource PanelEdge}"
               TextChanged="SearchBox_TextChanged"/>

      <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" LastChildFill="False">
        <Button Content="CLEAR" DockPanel.Dock="Left" Padding="14,8"
                FontFamily="{StaticResource PixelFont}" FontSize="10" Click="Clear_Click"/>
        <Button Content="APPLY" DockPanel.Dock="Right" Padding="14,8" Margin="10,0,0,0"
                FontFamily="{StaticResource PixelFont}" FontSize="10" Click="Apply_Click"/>
        <Button Content="CANCEL" DockPanel.Dock="Right" Padding="14,8"
                FontFamily="{StaticResource PixelFont}" FontSize="10" Click="Cancel_Click"/>
      </DockPanel>

      <ListBox x:Name="List" Background="#FF0B0B11" BorderBrush="{StaticResource PanelEdge}"
               Foreground="Gainsboro" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Content="{Binding Display}"
                      Foreground="Gainsboro" Margin="4,3"/>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
  </Border>
</Window>
