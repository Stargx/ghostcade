<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <Version>0.1.0</Version>
    <Authors>Cold Beam Games</Authors>
    <Product>Attractor</Product>
    <Description>Ambient arcade player — cycles your MAME collection through attract mode while you work.</Description>
    <Copyright>Copyright © 2026 Cold Beam Games</Copyright>
  </PropertyGroup>

</Project>
